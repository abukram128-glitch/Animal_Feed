    "🌾 الحبوب": {
        "ذرة صفراء": create_ingredient(8.5, 80, 230, "ذرة صفراء"),
        "شعير": create_ingredient(11.5, 71, 210, "شعير"),
        "قمح": create_ingredient(12.0, 75, 240, "قمح"),
    },
    "🌱 البروتين": {
        "كسب صويا 44%": create_ingredient(44.0, 74, 440, "كسب صويا"),
        "كسب عباد شمس": create_ingredient(36.0, 42, 310, "كسب عباد شمس"),
