def check_owner_code(user_input):
    try:
        blob = "Nzg2MjAy"
        expected = hashlib.sha256(base64.b64decode(blob).decode()[::-1].encode()).hexdigest()
        return hashlib.sha256(user_input.strip().encode()).hexdigest() == expected
    except Exception:
        return False

