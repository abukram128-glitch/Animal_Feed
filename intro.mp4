    "أغنام": "https://upload.wikimedia.org/wikipedia/commons/thumb/8/8a/Sheep_in_lesser_himalayas.JPG/1024px-Sheep_in_lesser_himalayas.JPG",
    "ماعز": "https://upload.wikimedia.org/wikipedia/commons/thumb/b/b2/Goat_chewing_a_can_%28cropped%29.jpg/1024px-Goat_chewing_a_can_%28cropped%29.jpg",
    "إبل": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/4e/Camel_in_Dubai.jpg/1024px-Camel_in_Dubai.jpg",
    "خيول": "https://upload.wikimedia.org/wikipedia/commons/thumb/d/de/Nokota_Horses_cropped.jpg/1024px-Nokota_Horses_cropped.jpg",
}

@st.cache_data(ttl=86400)
def fetch_image(url):
    try:
        import urllib.request
        req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
        with urllib.request.urlopen(req, timeout=10) as resp:
            return resp.read()
    except Exception:
        return None

def draw_weight_guide(animal_type):
    if not MATPLOTLIB_AVAILABLE: return None
    try:
        img_bytes = fetch_image(ANIMAL_IMG_URLS.get(animal_type, ANIMAL_IMG_URLS["أبقار"]))
        fig, ax = plt.subplots(figsize=(10, 6))
        if img_bytes:
            img = Image.open(io.BytesIO(img_bytes))
            ax.imshow(img)
        else:
            ax.text(0.5, 0.5, "لا توجد صورة", ha='center', va='center')
        
        ax.axis('off')
        # رسم أسهم القياس على الصورة
        # سهم أحمر لمحيط الصدر
        ax.annotate('', xy=(0.35, 0.6), xytext=(0.35, 0.3), xycoords='axes fraction', arrowprops=dict(arrowstyle='<->', color='red', lw=3))
        ax.text(0.37, 0.45, 'محيط الصدر', color='red', fontsize=12, fontweight='bold', transform=ax.transAxes)
        
        # سهم أزرق لطول الجسم
        ax.annotate('', xy=(0.15, 0.2), xytext=(0.85, 0.2), xycoords='axes fraction', arrowprops=dict(arrowstyle='<->', color='blue', lw=3))
        ax.text(0.5, 0.22, 'طول الجسم', color='blue', fontsize=12, fontweight='bold', ha='center', transform=ax.transAxes)
        
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=120, bbox_inches='tight', facecolor='white')
        plt.close(); buf.seek(0)
        return buf
    except Exception:
        return None

