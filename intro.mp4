def render_pdf_download_button(pdf_bytes, filename, key):
    """دالة موحدة لعرض زر التحميل مع القيود"""
    if is_owner:
        st.download_button("📄 تحميل PDF", pdf_bytes, file_name=filename, mime="application/pdf", use_container_width=True, type="primary", key=key)
    else:
        if st.session_state["pdf_approved"]:
            st.success("✅ تمت الموافقة من المالك (مؤقتاً)")
            st.download_button("📄 تحميل PDF", pdf_bytes, file_name=filename, mime="application/pdf", use_container_width=True, type="primary", key=key)
        else:
            st.warning("🔒 تحميل الـ PDF يتطلب موافقة المالك.")
            c1, c2 = st.columns(2)
            with c1:
                if st.button("طلب موافقة المالك", key=f"req_{key}"):
                    st.info("تم إرسال الطلب! يرجى التواصل مع الدكتور للاعتماد.")
            with c2:
                st.markdown(f'<a href="https://wa.me/{WHATSAPP_NUMBER.replace("+","")}" target="_blank" style="display:block; padding:10px; background:#25d366; color:white; text-align:center; border-radius:10px; text-decoration:none; font-weight:bold;">📱 واتساب</a>', unsafe_allow_html=True)

