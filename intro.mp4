# تهيئة الخطوط العربية للـ PDF
@lru_cache(maxsize=1)
def init_fonts():
    try:
        if os.path.exists("Amiri-Regular.ttf"):
            pdfmetrics.registerFont(TTFont('Arabic', 'Amiri-Regular.ttf'))
            return 'Arabic'
    except Exception:
        pass
    return 'Helvetica'

FONT_NAME = init_fonts()

def ar(text):
    if not text: return ""
    if not ARABIC_AVAILABLE: return str(text)
    try:
        return get_display(arabic_reshaper.reshape(str(text)), base_dir='R')
    except Exception:
        return str(text)

