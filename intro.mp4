else:
    tabs = st.tabs(["🔬 النمذجة", "🏗️ الحظائر", "📚 المراجع"])

with tabs[0]:
    st.header("🔬 تركيب علفي (نموذج تجريبي)")
    
    col1, col2 = st.columns(2)
    with col1:
        animal = st.selectbox("اختر الحيوان:", list(ANIMAL_IMG_URLS.keys()))
        st.markdown("#### دليل القياس")
        guide_img = draw_weight_guide(animal)
        if guide_img:
            st.image(guide_img, use_column_width=True)
    with col2:
        st.markdown("#### إدخال الوزن")
        hg = st.number_input("محيط الصدر (سم):", 50.0, 250.0, 180.0)
        bl = st.number_input("طول الجسم (سم):", 50.0, 250.0, 150.0)
        weight = (hg**2 * bl) / 10840.0
        st.metric("⚖️ الوزن التقديري", f"{weight:.1f} كجم")
    
    st.markdown("---")
    
    # اختيار المكونات
    st.markdown("### 🌾 اختر المكونات")
    selected_feeds = {}
    for cat, items in FEED_LIBRARY.items():
        with st.expander(cat):
            for name, data in items.items():
                pct = st.number_input(f"{name} (نسبة %):", 0.0, 100.0, 0.0, key=f"feed_{name}")
                if pct > 0:
                    selected_feeds[name] = pct
    
    if st.button("🚀 تشغيل التركيب", type="primary"):
        if not selected_feeds:
            st.error("⚠️ اختر مكونات أولاً")
        else:
            total = sum(selected_feeds.values())
            if abs(total - 100) > 0.1:
                st.warning(f"⚠️ المجموع {total}% — سيتم التطبيع")
            
            # حساب النسب المئوية للـ CP
            total_cp = sum(FEED_LIBRARY[c][n]["CP"] * (p/total) for c, items in FEED_LIBRARY.items() for n, p in selected_feeds.items() if n in items)
            total_se = sum(FEED_LIBRARY[c][n]["SE"] * (p/total) for c, items in FEED_LIBRARY.items() for n, p in selected_feeds.items() if n in items)
            
            st.success(f"✅ التركيبة: بروتين {total_cp:.1f}% | طاقة {total_se:.0f}")
            
            # إنشاء PDF
            try:
                buf = io.BytesIO()
                doc = SimpleDocTemplate(buf, pagesize=A4)
                story = [
                    Paragraph(ar("تقرير تركيبة علفية"), ParagraphStyle('t', fontName=FONT_NAME, fontSize=20, alignment=TA_CENTER)),
                    Spacer(1, 12),
                    Table([[ar("المكون"), ar("النسبة %")]] + [[ar(k), f"{v}%"] for k, v in selected_feeds.items()])
                ]
                doc.build(story)
                pdf_bytes = buf.getvalue()
                
                # عرض زر التحميل مع القيود
                render_pdf_download_button(pdf_bytes, "formula.pdf", "formula_pdf")
                
                # أزرار التواصل والاستشارة
                render_contact_section()
                
            except Exception as e:
                st.error(f"خطأ في PDF: {e}")

